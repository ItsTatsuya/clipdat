{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cliper",
  "version": "0.1.0",
  "identifier": "com.cliper9000.player",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Cliper",
        "width": 1280,
        "height": 760,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/mpv", "binaries/ffmpeg", "binaries/ffprobe"],
    "fileAssociations": [
      {
        "ext": ["mp4", "mkv", "mov", "webm", "avi", "m4v", "ts", "m2ts", "flv", "wmv", "mpg", "mpeg", "3gp", "ogv"],
        "name": "Video",
        "description": "Video file",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
